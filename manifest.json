{
  "manifest_version": 3,
  "name": "AWS Console – Blue Dark Mode",
  "version": "1.0.0",
  "description": "Restores the blue-tinted dark mode in the AWS Management Console.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://*.awsstatic.com/*",
    "https://*.console.aws.amazon.com/*",
    "https://console.aws.amazon.com/*",
    "https://*.console.aws/*",
    "https://*.console.api.aws/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.console.aws.amazon.com/*",
        "https://console.aws.amazon.com/*",
        "https://*.console.aws/*",
        "https://*.console.api.aws/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AWS Blue Dark Mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
